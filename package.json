{
  "name": "vinteq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{json,js,mjs,ts}\" \"src/main.tsx\" \"src/test-setup.ts\"",
    "format:check": "prettier --check \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{json,js,mjs,ts}\" \"src/main.tsx\" \"src/test-setup.ts\"",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/react": "^11.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  }
}
